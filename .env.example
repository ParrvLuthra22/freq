# Base URL of the freq-ai proxy (see ../freq-ai). "EXPO_PUBLIC_" makes this
# available in the client bundle — it's just a URL, never a secret.
#
# OPTIONAL, and deliberately left blank here. Every AI feature (archetype,
# compatibility explanation, icebreakers) falls back to copy derived from real
# listening data, so an unset proxy costs polish rather than correctness. Do not
# point this at localhost in a deployed build — the app would fire a request on
# every profile build that can only fail.
EXPO_PUBLIC_AI_PROXY_URL=

# Supabase. Both are safe in the client bundle: the anon key is public by design
# and only useful alongside row-level security. Never put the service_role key
# in an EXPO_PUBLIC_ var — it bypasses RLS entirely.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
